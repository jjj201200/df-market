#!/usr/bin/env node
/**
 * Token Reporter Status CLI
 * Shows current status of the token-reporter server
 */

const fs = require('fs');
const os = require('os');
const path = require('path');

const R = '\x1b[0m';
const GREEN = '\x1b[32m';
const RED = '\x1b[31m';
const YELLOW = '\x1b[33m';
const CYAN = '\x1b[36m';

const d = process.env.TOKEN_REPORTER_DATA_DIR || path.join(os.homedir(), '.claude', 'token-reporter');
const pidPath = path.join(d, 'server.pid');
const configPath = path.join(d, 'config.json');

let config = { port: 3737, autoStart: true };
try {
  config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
} catch {}

let running = false;
let pid = null;
try {
  pid = parseInt(fs.readFileSync(pidPath, 'utf8').trim());
  process.kill(pid, 0);
  running = true;
} catch {}

let sessions = 0;
try {
  sessions = fs.readdirSync(path.join(d, 'sessions')).filter(f => f.endsWith('.jsonl')).length;
} catch {}

const statusText = running
  ? GREEN + 'running' + R
  : RED + 'stopped' + R;
const autoStartText = config.autoStart !== false
  ? GREEN + 'on' + R
  : YELLOW + 'off' + R;

// 3列动态对齐布局 - key和value分别对齐
const stripAnsi = (str) => str.replace(/\x1b\[\d+m/g, '');
const visibleLen = (str) => stripAnsi(String(str)).length;

// 定义数据行（每行3列：[key, value]）
const row1 = running
  ? [['Status', statusText], ['URL', CYAN + 'http://localhost:' + config.port + R], ['PID', pid]]
  : [['Status', statusText], ['Port', config.port], ['Auto', autoStartText]];
const row2 = running
  ? [['Port', config.port], ['Auto', autoStartText], ['Sessions', sessions]]
  : null;

// 计算每列的总宽度（key + ": " + value）
const rows = row2 ? [row1, row2] : [row1];
const colWidths = [0, 0, 0];
for (const row of rows) {
  for (let i = 0; i < 3; i++) {
    const [key, value] = row[i];
    const len = visibleLen(key) + 2 + visibleLen(value); // "key: value"
    colWidths[i] = Math.max(colWidths[i], len);
  }
}

// 对齐输出：key左对齐，整列宽度固定
const formatRow = (row) => {
  return row.map(([key, value], i) => {
    const text = `${key}: ${value}`;
    const padding = ' '.repeat(Math.max(0, colWidths[i] - visibleLen(text)));
    return text + padding + '  ';
  }).join('');
};

console.log(formatRow(row1));
if (row2) console.log(formatRow(row2));

process.exit(0);
