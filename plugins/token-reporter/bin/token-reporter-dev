#!/usr/bin/env node
"use strict";
/**
 * Start token-reporter development/test instance
 * Uses port 13737 and isolated data directory
 * Usage: token-reporter-dev [start|stop|status]
 */

const { spawn, execSync } = require("child_process");
const fs = require("fs");
const path = require("path");
const os = require("os");

const DEFAULT_DEV_PORT = 13737;
const MAX_PORT_ATTEMPTS = 10;
const DEV_DATA_DIR = path.join(os.tmpdir(), "token-reporter-dev");
const PID_FILE = path.join(DEV_DATA_DIR, "server.pid");
const CONFIG_PATH = path.join(DEV_DATA_DIR, "config.json");

// Use current working directory if it's a token-reporter plugin directory,
// otherwise fall back to the directory where this script is located
const CWD_PLUGIN_ROOT = process.cwd();
const SCRIPT_PLUGIN_ROOT = path.resolve(__dirname, "..");
const PLUGIN_ROOT = (fs.existsSync(path.join(CWD_PLUGIN_ROOT, "backend", "server.js"))
  ? CWD_PLUGIN_ROOT
  : SCRIPT_PLUGIN_ROOT);

// Production config path (for updating statusLineTargets)
const PROD_DATA_DIR = path.join(os.homedir(), ".claude", "token-reporter");
const PROD_CONFIG_PATH = path.join(PROD_DATA_DIR, "config.json");

function readJSON(p, fallback) {
  try {
    return JSON.parse(fs.readFileSync(p, "utf8"));
  } catch {
    return fallback;
  }
}

function isProcessAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function getPid() {
  if (!fs.existsSync(PID_FILE)) return null;
  try {
    return parseInt(fs.readFileSync(PID_FILE, "utf8").trim());
  } catch {
    return null;
  }
}

function findAvailablePort() {
  for (let port = DEFAULT_DEV_PORT; port < DEFAULT_DEV_PORT + MAX_PORT_ATTEMPTS; port++) {
    const occupyingPid = getProcessOnPort(port);
    if (!occupyingPid) {
      // Port is free
      return port;
    }
    // Port is occupied, check if it's another token-reporter instance
    if (isTokenReporterProcess(occupyingPid)) {
      console.error(`❌ Another token-reporter instance is already running on port ${port}`);
      console.error(`   PID: ${occupyingPid}`);
      console.error(`   Please stop it first with: token-reporter-dev stop`);
      process.exit(1);
    }
    // Port is occupied by non-token-reporter, try next
  }
  return null;
}

function getProcessOnPort(port) {
  try {
    const output = execSync(`lsof -i :${port} -sTCP:LISTEN -t 2>/dev/null`, { encoding: 'utf8' });
    const pid = parseInt(output.trim().split('\n')[0]);
    return pid || null;
  } catch {
    return null;
  }
}

function isTokenReporterProcess(pid) {
  try {
    const cmdline = execSync(`ps -p ${pid} -o comm= 2>/dev/null`, { encoding: 'utf8' });
    return cmdline.includes('node') || cmdline.includes('token');
  } catch {
    return false;
  }
}

function findTokenReporterProcess() {
  try {
    // Search for node processes running token-reporter's server.js
    const output = execSync(
      `ps aux 2>/dev/null | grep -E 'node.*token-reporter.*server\.js' | grep -v grep || true`,
      { encoding: 'utf8' }
    );
    const lines = output.trim().split('\n').filter(line => line.trim());
    if (lines.length === 0) return null;
    // Return the first match's PID
    const parts = lines[0].trim().split(/\s+/);
    const pid = parseInt(parts[1]);
    return pid || null;
  } catch {
    return null;
  }
}

function getActualPort() {
  try {
    const config = readJSON(CONFIG_PATH, { port: DEFAULT_DEV_PORT });
    return config.port || DEFAULT_DEV_PORT;
  } catch {
    return DEFAULT_DEV_PORT;
  }
}

function start() {
  const port = findAvailablePort();
  if (!port) {
    console.error(`Could not find an available port after ${MAX_PORT_ATTEMPTS} attempts.`);
    console.error(`   Tried ports: ${DEFAULT_DEV_PORT} - ${DEFAULT_DEV_PORT + MAX_PORT_ATTEMPTS - 1}`);
    process.exit(1);
  }

  if (port !== DEFAULT_DEV_PORT) {
    console.log(`Default port ${DEFAULT_DEV_PORT} is in use, using port ${port} instead.`);
  }

  const existingPid = getPid();
  if (existingPid && isProcessAlive(existingPid)) {
    console.log(`Dev server already running at http://localhost:${getActualPort()}`);
    return;
  }

  const pid = ensureApiServer(port);
  if (!pid) {
    console.error("Error: Server failed to start within 3 seconds.");
    process.exit(1);
  }

  console.log(`Dev server started at http://localhost:${getActualPort()}`);
  console.log(`Data directory: ${DEV_DATA_DIR}`);
}

function addDevTargetToProdConfig(port) {
  try {
    fs.mkdirSync(PROD_DATA_DIR, { recursive: true });
    const config = readJSON(PROD_CONFIG_PATH, { port: 3737, autoStart: true });
    if (!config.statusLineTargets) {
      config.statusLineTargets = [`http://localhost:${config.port || 3737}/api/limits`];
    }
    const devTarget = `http://localhost:${port}/api/limits`;
    if (!config.statusLineTargets.includes(devTarget)) {
      config.statusLineTargets.push(devTarget);
      fs.writeFileSync(PROD_CONFIG_PATH, JSON.stringify(config, null, 2));
      console.log(`Added ${devTarget} to status line targets`);
    }
  } catch (e) {
    console.error(`Warning: Could not update production config: ${e.message}`);
  }
}

function removeDevTargetFromProdConfig() {
  try {
    const config = readJSON(PROD_CONFIG_PATH, null);
    if (!config || !config.statusLineTargets) return;
    // Remove any dev server targets (ports 13737+)
    const originalLength = config.statusLineTargets.length;
    config.statusLineTargets = config.statusLineTargets.filter(target => {
      const match = target.match(/:(\d+)\/api\/limits$/);
      if (!match) return true;
      const port = parseInt(match[1]);
      return port < 13737 || port >= 13737 + MAX_PORT_ATTEMPTS;
    });
    if (config.statusLineTargets.length !== originalLength) {
      fs.writeFileSync(PROD_CONFIG_PATH, JSON.stringify(config, null, 2));
      console.log(`Removed dev server targets from status line targets`);
    }
  } catch (e) {
    // Ignore errors
  }
}

function stop() {
  let pid = null;

  // Priority 1: Search for token-reporter process by command line
  pid = findTokenReporterProcess();
  if (pid) {
    console.log(`Found token-reporter process by search (PID ${pid}).`);
  }

  // Priority 2: Try PID file if process search didn't find anything
  if (!pid) {
    pid = getPid();
    if (pid) {
      console.log(`Found token-reporter process by PID file (PID ${pid}).`);
    }
  }

  // Priority 3: Try to find process by port as last resort
  if (!pid) {
    const port = getActualPort();
    pid = getProcessOnPort(port);
    if (pid) {
      if (!isTokenReporterProcess(pid)) {
        console.log(`Port ${port} is occupied by a non-token-reporter process (PID ${pid}).`);
        console.log("Dev server not running.");
        return;
      }
      console.log(`Found token-reporter process by port ${port} (PID ${pid}).`);
    }
  }

  if (!pid || !isProcessAlive(pid)) {
    // Clean up stale PID file
    try { fs.unlinkSync(PID_FILE); } catch {}
    console.log("Dev server not running.");
    return;
  }

  // Send SIGTERM for graceful shutdown
  try {
    process.kill(pid, "SIGTERM");
  } catch (e) {
    console.error(`Error stopping server: ${e.message}`);
    return;
  }

  // Wait up to 3 seconds for graceful shutdown
  let stopped = false;
  for (let i = 0; i < 3; i++) {
    try {
      process.kill(pid, 0);
    } catch {
      stopped = true;
      break;
    }
    execSync("sleep 1");
  }

  // Force kill with SIGKILL if still running
  if (!stopped) {
    try {
      process.kill(pid, "SIGKILL");
      console.log("Dev server stopped (forced).");
    } catch (e) {
      console.error(`Error force-stopping server: ${e.message}`);
    }
  } else {
    console.log("Dev server stopped.");
  }

  // Clean up PID file
  try { fs.unlinkSync(PID_FILE); } catch {}

  // Remove dev target from production config
  removeDevTargetFromProdConfig();
}

function status() {
  const pid = getPid();
  if (pid && isProcessAlive(pid)) {
    const actualPort = getActualPort();
    console.log(`Dev server running at http://localhost:${actualPort}`);
    console.log(`PID: ${pid}`);
    console.log(`Data directory: ${DEV_DATA_DIR}`);
  } else {
    console.log("Dev server not running.");
    console.log(`Run 'token-reporter-dev start' to start.`);
  }
}

function ensureApiServer(port) {
  fs.mkdirSync(DEV_DATA_DIR, { recursive: true });
  fs.writeFileSync(CONFIG_PATH, JSON.stringify({ port, autoStart: true }, null, 2));

  const existingPid = getPid();
  if (existingPid && isProcessAlive(existingPid)) {
    return existingPid;
  }

  const child = spawn(process.execPath, [path.join(PLUGIN_ROOT, "backend", "server.js")], {
    detached: true,
    stdio: "ignore",
    env: {
      ...process.env,
      TOKEN_REPORTER_PLUGIN_ROOT: PLUGIN_ROOT,
      TOKEN_REPORTER_DATA_DIR: DEV_DATA_DIR,
    },
  });
  child.unref();

  for (let i = 0; i < 30; i++) {
    const pid = getPid();
    if (pid && isProcessAlive(pid)) {
      addDevTargetToProdConfig(port);
      return pid;
    }
    execSync("sleep 0.1");
  }
  return null;
}

function startHmr() {
  const apiPort = DEFAULT_DEV_PORT + 1;
  const hmrPort = DEFAULT_DEV_PORT;

  const pid = ensureApiServer(apiPort);
  if (!pid) {
    console.error("Error: API server failed to start within 3 seconds.");
    process.exit(1);
  }
  console.log(`API server running on port ${apiPort} (PID ${pid})`);

  const frontendDir = path.join(PLUGIN_ROOT, "frontend");
  if (!fs.existsSync(path.join(frontendDir, "node_modules"))) {
    console.log("Installing frontend dependencies...");
    execSync("npm ci --silent", { cwd: frontendDir, stdio: "inherit" });
  }

  console.log(`\nStarting Vite HMR on http://localhost:${hmrPort}`);
  console.log(`   API proxy -> http://localhost:${apiPort}`);
  console.log(`   Press Ctrl+C to stop\n`);

  const viteChild = spawn(
    path.join(frontendDir, "node_modules", ".bin", "vite"),
    [],
    {
      cwd: frontendDir,
      stdio: "inherit",
      env: {
        ...process.env,
        VITE_HMR_PORT: String(hmrPort),
        VITE_API_PORT: String(apiPort),
      },
    }
  );

  const cleanup = () => {
    viteChild.kill("SIGTERM");
    process.exit(0);
  };
  process.on("SIGINT", cleanup);
  process.on("SIGTERM", cleanup);
}

const command = process.argv[2] || "start";

switch (command) {
  case "start":
    start();
    break;
  case "hmr":
    startHmr();
    break;
  case "stop":
    stop();
    break;
  case "status":
    status();
    break;
  default:
    console.log("Usage: token-reporter-dev [start|stop|status|hmr]");
    process.exit(1);
}
