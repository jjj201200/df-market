#!/usr/bin/env node
"use strict";
/**
 * Start token-reporter development/test instance
 * Uses port 13737 and isolated data directory
 * Usage: token-reporter-dev [start|stop|status]
 */

import { spawn, execSync } from "child_process";
import fs from "fs";
import path from "path";
import os from "os";

const DEFAULT_DEV_PORT = 13737;
const MAX_PORT_ATTEMPTS = 10;
const DEV_DATA_DIR = path.join(os.tmpdir(), "token-reporter-dev");
const PID_FILE = path.join(DEV_DATA_DIR, "server.pid");
const VITE_PID_FILE = path.join(DEV_DATA_DIR, "vite.pid");
const VITE_LOG_FILE = path.join(DEV_DATA_DIR, "vite.log");
const CONFIG_PATH = path.join(DEV_DATA_DIR, "config.json");

// Resolve plugin root for the dev server.
// Priority: env var > CWD match > git repo root > saved devRoot > script dir.
// Once found, devRoot is persisted so future runs from any location work.
function resolvePluginRoot() {
  const scriptDir = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
  const marker = path.join("backend", "dist", "server.js");
  const devConfig = readJSON(CONFIG_PATH, {});

  function tryPlugin(dir) {
    return dir && fs.existsSync(path.join(dir, marker)) ? dir : null;
  }

  // 0. Explicit env var — always wins
  let found = tryPlugin(process.env.TOKEN_REPORTER_DEV_ROOT);

  // 1. Script's own directory (development mode - use current plugin source)
  if (!found) found = tryPlugin(scriptDir);

  // 2. CWD is the plugin root
  if (!found) found = tryPlugin(process.cwd());

  // 3. CWD contains plugins/token-reporter/
  if (!found) found = tryPlugin(path.join(process.cwd(), "plugins", "token-reporter"));

  // 4. Use git to find repo root, then check plugins/token-reporter/ inside it
  if (!found) {
    try {
      const repoRoot = execSync("git rev-parse --show-toplevel 2>/dev/null", { encoding: "utf8" }).trim();
      if (repoRoot) found = tryPlugin(path.join(repoRoot, "plugins", "token-reporter"));
    } catch {}
  }

  // Persist devRoot for future runs
  if (found) {
    if (devConfig.devRoot !== found) {
      fs.mkdirSync(DEV_DATA_DIR, { recursive: true });
      fs.writeFileSync(CONFIG_PATH, JSON.stringify({ ...devConfig, devRoot: found }, null, 2));
    }
    return found;
  }

  // 5. Use saved devRoot from a previous run
  if (devConfig.devRoot && tryPlugin(devConfig.devRoot)) return devConfig.devRoot;

  // 6. Fall back to script's own directory
  return scriptDir;
}

const PLUGIN_ROOT = resolvePluginRoot();

// Production config path (for updating statusLineTargets)
const PROD_DATA_DIR = path.join(os.homedir(), ".claude", "token-reporter");
const PROD_CONFIG_PATH = path.join(PROD_DATA_DIR, "config.json");

function readJSON(p, fallback) {
  try {
    return JSON.parse(fs.readFileSync(p, "utf8"));
  } catch {
    return fallback;
  }
}

function isProcessAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function getPid() {
  if (!fs.existsSync(PID_FILE)) return null;
  try {
    return parseInt(fs.readFileSync(PID_FILE, "utf8").trim());
  } catch {
    return null;
  }
}

function findAvailablePort() {
  for (let port = DEFAULT_DEV_PORT; port < DEFAULT_DEV_PORT + MAX_PORT_ATTEMPTS; port++) {
    const occupyingPid = getProcessOnPort(port);
    if (!occupyingPid) {
      // Port is free
      return port;
    }
    // Port is occupied, check if it's another token-reporter instance
    if (isTokenReporterProcess(occupyingPid)) {
      console.error(`❌ Another token-reporter instance is already running on port ${port}`);
      console.error(`   PID: ${occupyingPid}`);
      console.error(`   Please stop it first with: token-reporter-dev stop`);
      process.exit(1);
    }
    // Port is occupied by non-token-reporter, try next
  }
  return null;
}

function getProcessOnPort(port) {
  try {
    const output = execSync(`lsof -i :${port} -sTCP:LISTEN -t 2>/dev/null`, { encoding: 'utf8' });
    const pid = parseInt(output.trim().split('\n')[0]);
    return pid || null;
  } catch {
    return null;
  }
}

function isTokenReporterProcess(pid) {
  try {
    const cmdline = execSync(`ps -p ${pid} -o comm= 2>/dev/null`, { encoding: 'utf8' });
    return cmdline.includes('node') || cmdline.includes('token');
  } catch {
    return false;
  }
}

function findTokenReporterProcess() {
  try {
    // Search for node processes running token-reporter's server.js
    const output = execSync(
      `ps aux 2>/dev/null | grep -E 'node.*token-reporter.*server\\.js' | grep -v grep || true`,
      { encoding: 'utf8' }
    );
    const lines = output.trim().split('\n').filter(line => line.trim());
    if (lines.length === 0) return null;
    // Return the first match's PID
    const parts = lines[0].trim().split(/\s+/);
    const pid = parseInt(parts[1]);
    return pid || null;
  } catch {
    return null;
  }
}

function getVitePid() {
  if (!fs.existsSync(VITE_PID_FILE)) return null;
  try {
    return parseInt(fs.readFileSync(VITE_PID_FILE, "utf8").trim());
  } catch {
    return null;
  }
}

function getActualPort() {
  try {
    const config = readJSON(CONFIG_PATH, { port: DEFAULT_DEV_PORT });
    return config.port || DEFAULT_DEV_PORT;
  } catch {
    return DEFAULT_DEV_PORT;
  }
}

function ensureViteServer(hmrPort, apiPort) {
  const frontendDir = path.join(PLUGIN_ROOT, "frontend");
  if (!fs.existsSync(path.join(frontendDir, "package.json"))) {
    return null;
  }
  if (!fs.existsSync(path.join(frontendDir, "node_modules"))) {
    console.log("Installing frontend dependencies...");
    execSync("npm ci --silent", { cwd: frontendDir, stdio: "inherit" });
  }

  const viteBin = path.join(frontendDir, "node_modules", ".bin", "vite");
  if (!fs.existsSync(viteBin)) return null;

  const logFd = fs.openSync(VITE_LOG_FILE, "a");
  const viteChild = spawn(viteBin, [], {
    cwd: frontendDir,
    detached: true,
    stdio: ["ignore", logFd, logFd],
    env: {
      ...process.env,
      VITE_HMR_PORT: String(hmrPort),
      VITE_API_PORT: String(apiPort),
    },
  });
  fs.closeSync(logFd);
  viteChild.unref();

  fs.writeFileSync(VITE_PID_FILE, String(viteChild.pid));

  // Wait for Vite to be ready
  for (let i = 0; i < 50; i++) {
    const pid = getProcessOnPort(hmrPort);
    if (pid) return viteChild.pid;
    execSync("sleep 0.1");
  }
  return null;
}

function start() {
  const hmrPort = DEFAULT_DEV_PORT;
  const apiPort = DEFAULT_DEV_PORT + 1;

  // Check if already running
  const existingPid = getPid();
  if (existingPid && isProcessAlive(existingPid)) {
    console.log(`Dev server already running at http://localhost:${hmrPort}`);
    return;
  }

  // Check port availability for both ports
  for (const port of [hmrPort, apiPort]) {
    const occupyingPid = getProcessOnPort(port);
    if (occupyingPid) {
      if (isTokenReporterProcess(occupyingPid)) {
        console.error(`Another token-reporter instance is on port ${port} (PID ${occupyingPid}).`);
        console.error(`   Please stop it first with: token-reporter-dev stop`);
        process.exit(1);
      }
      console.error(`Port ${port} is occupied by another process (PID ${occupyingPid}).`);
      process.exit(1);
    }
  }

  // Start API server on apiPort
  const apiPid = ensureApiServer(apiPort);
  if (!apiPid) {
    console.error("Error: API server failed to start.");
    process.exit(1);
  }

  // Start Vite HMR on hmrPort
  const vitePid = ensureViteServer(hmrPort, apiPort);
  if (!vitePid) {
    console.log(`API server started at http://localhost:${apiPort} (no HMR — frontend not found)`);
    console.log(`Data directory: ${DEV_DATA_DIR}`);
    return;
  }

  // Update config with both ports
  const config = readJSON(CONFIG_PATH, {});
  config.port = hmrPort;
  config.apiPort = apiPort;
  fs.writeFileSync(CONFIG_PATH, JSON.stringify(config, null, 2));

  // Register the API port for status line
  addDevTargetToProdConfig(apiPort);

  console.log(`Dev server started at http://localhost:${hmrPort} (HMR)`);
  console.log(`   API server on port ${apiPort}`);
  console.log(`   Vite log: ${VITE_LOG_FILE}`);
  console.log(`Data directory: ${DEV_DATA_DIR}`);
}

function addDevTargetToProdConfig(port) {
  try {
    fs.mkdirSync(PROD_DATA_DIR, { recursive: true });
    const config = readJSON(PROD_CONFIG_PATH, { port: 3737, autoStart: true });
    if (!config.statusLineTargets) {
      config.statusLineTargets = [`http://localhost:${config.port || 3737}/api/limits`];
    }
    const devTarget = `http://localhost:${port}/api/limits`;
    if (!config.statusLineTargets.includes(devTarget)) {
      config.statusLineTargets.push(devTarget);
      fs.writeFileSync(PROD_CONFIG_PATH, JSON.stringify(config, null, 2));
      console.log(`Added ${devTarget} to status line targets`);
    }
  } catch (e) {
    console.error(`Warning: Could not update production config: ${e.message}`);
  }
}

function removeDevTargetFromProdConfig() {
  try {
    const config = readJSON(PROD_CONFIG_PATH, null);
    if (!config || !config.statusLineTargets) return;
    // Remove any dev server targets (ports 13737+)
    const originalLength = config.statusLineTargets.length;
    config.statusLineTargets = config.statusLineTargets.filter(target => {
      const match = target.match(/:(\d+)\/api\/limits$/);
      if (!match) return true;
      const port = parseInt(match[1]);
      return port < 13737 || port >= 13737 + MAX_PORT_ATTEMPTS;
    });
    if (config.statusLineTargets.length !== originalLength) {
      fs.writeFileSync(PROD_CONFIG_PATH, JSON.stringify(config, null, 2));
      console.log(`Removed dev server targets from status line targets`);
    }
  } catch (e) {
    // Ignore errors
  }
}

function killProcess(pid, label) {
  if (!pid || !isProcessAlive(pid)) return false;

  try {
    process.kill(pid, "SIGTERM");
  } catch (e) {
    console.error(`Error stopping ${label}: ${e.message}`);
    return false;
  }

  for (let i = 0; i < 3; i++) {
    try { process.kill(pid, 0); } catch { return true; }
    execSync("sleep 1");
  }

  try {
    process.kill(pid, "SIGKILL");
    return true;
  } catch {
    return false;
  }
}

function stop() {
  let apiPid = null;

  // Find API server process
  apiPid = findTokenReporterProcess();
  if (!apiPid) apiPid = getPid();
  if (!apiPid) {
    const config = readJSON(CONFIG_PATH, {});
    const port = config.apiPort || DEFAULT_DEV_PORT + 1;
    const portPid = getProcessOnPort(port);
    if (portPid && isTokenReporterProcess(portPid)) apiPid = portPid;
  }

  // Kill Vite server
  const vitePid = getVitePid();
  if (vitePid && isProcessAlive(vitePid)) {
    killProcess(vitePid, "Vite HMR");
  }
  try { fs.unlinkSync(VITE_PID_FILE); } catch {}

  // Kill API server
  if (!apiPid || !isProcessAlive(apiPid)) {
    try { fs.unlinkSync(PID_FILE); } catch {}
    if (!vitePid) {
      console.log("Dev server not running.");
    } else {
      console.log("Dev server stopped.");
    }
    removeDevTargetFromProdConfig();
    return;
  }

  killProcess(apiPid, "API server");
  try { fs.unlinkSync(PID_FILE); } catch {}

  console.log("Dev server stopped.");
  removeDevTargetFromProdConfig();
}

function status() {
  const config = readJSON(CONFIG_PATH, {});
  const apiPid = getPid();
  const vitePid = getVitePid();
  const apiAlive = apiPid && isProcessAlive(apiPid);
  const viteAlive = vitePid && isProcessAlive(vitePid);

  if (!apiAlive && !viteAlive) {
    console.log("Dev server not running.");
    console.log(`Run 'token-reporter-dev start' to start.`);
    return;
  }

  if (viteAlive) {
    console.log(`Vite HMR running at http://localhost:${config.port || DEFAULT_DEV_PORT} (PID ${vitePid})`);
  }
  if (apiAlive) {
    console.log(`API server running on port ${config.apiPort || DEFAULT_DEV_PORT + 1} (PID ${apiPid})`);
  }
  console.log(`Plugin root: ${PLUGIN_ROOT}`);
  console.log(`Data directory: ${DEV_DATA_DIR}`);
}

function ensureApiServer(port) {
  fs.mkdirSync(DEV_DATA_DIR, { recursive: true });

  // Write config with port so server.js picks it up
  const config = readJSON(CONFIG_PATH, {});
  config.port = port;
  config.autoStart = true;
  fs.writeFileSync(CONFIG_PATH, JSON.stringify(config, null, 2));

  const existingPid = getPid();
  if (existingPid && isProcessAlive(existingPid)) {
    return existingPid;
  }

  const child = spawn(process.execPath, [path.join(PLUGIN_ROOT, "backend", "dist", "server.js")], {
    detached: true,
    stdio: "ignore",
    env: {
      ...process.env,
      TOKEN_REPORTER_PLUGIN_ROOT: PLUGIN_ROOT,
      TOKEN_REPORTER_DATA_DIR: DEV_DATA_DIR,
    },
  });
  child.unref();

  for (let i = 0; i < 30; i++) {
    const pid = getPid();
    if (pid && isProcessAlive(pid)) {
      return pid;
    }
    execSync("sleep 0.1");
  }
  return null;
}

const command = process.argv[2] || "start";

switch (command) {
  case "start":
    start();
    break;
  case "stop":
    stop();
    break;
  case "status":
    status();
    break;
  default:
    console.log("Usage: token-reporter-dev [start|stop|status]");
    process.exit(1);
}
