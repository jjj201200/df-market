#!/usr/bin/env node
// token-reporter-audit {on|off|status|purge}
// Injects NODE_OPTIONS=--require=<hook> via a zsh/bash alias in the user's
// shell rc. Writes two audit env keys into ~/.claude/settings.local.json for
// the hook itself (captures dir + active flag).

import fs from 'fs';
import os from 'os';
import path from 'path';
import readline from 'readline';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const PLUGIN_ROOT = process.env.TOKEN_REPORTER_PLUGIN_ROOT || path.resolve(__dirname, '..');

const DATA_DIR =
  process.env.TOKEN_REPORTER_DATA_DIR || path.join(os.homedir(), '.claude', 'token-reporter');
const SETTINGS_PATH =
  process.env.TOKEN_REPORTER_SETTINGS_PATH || path.join(os.homedir(), '.claude', 'settings.local.json');
const CONFIG_PATH = path.join(DATA_DIR, 'config.json');
const OUT_DIR =
  process.env.TOKEN_REPORTER_AUDIT_OUT_OVERRIDE || path.join(DATA_DIR, 'captures');

const auditSettingsPath = path.join(PLUGIN_ROOT, 'backend', 'dist', 'audit-settings.js');
const auditKeysPath = path.join(PLUGIN_ROOT, 'backend', 'dist', 'audit-keys.js');
const {
  enableAudit, disableAudit,
  readManagedSnapshot,
  loadAuditConfig,
  readHookHeartbeat, isHookStale,
  detectShellRc,
  detectExistingProxy,
} = await import(auditSettingsPath);
const { MANAGED_ENV_KEYS, hookPathForPlugin, SHELL_RC_MARKER } = await import(auditKeysPath);

function ensureDataDir() { fs.mkdirSync(DATA_DIR, { recursive: true }); }

// Buffer stdin lines so multiple confirm() calls don't race with each other.
const _lineQueue = [];
const _waiters = [];
let _rl = null;
let _stdinClosed = false;

function rlInit() {
  if (_rl) return;
  _rl = readline.createInterface({ input: process.stdin, terminal: false });
  _rl.on('line', (line) => {
    if (_waiters.length) _waiters.shift()(line);
    else _lineQueue.push(line);
  });
  _rl.on('close', () => {
    _stdinClosed = true;
    while (_waiters.length) _waiters.shift()(null);
  });
}
function rlClose() { if (_rl) { try { _rl.close(); } catch {} _rl = null; } }

function nextLine() {
  rlInit();
  if (_lineQueue.length) return Promise.resolve(_lineQueue.shift());
  if (_stdinClosed) return Promise.resolve(null);
  return new Promise((resolve) => _waiters.push(resolve));
}

const YES_FLAG = process.argv.includes('--yes') || process.argv.includes('-y');

async function confirm(prompt, defaultYes = false) {
  process.stdout.write(prompt);
  if (YES_FLAG) {
    process.stdout.write('y (auto)\n');
    return true;
  }
  const line = await nextLine();
  if (line === null) return defaultYes;
  const t = line.trim().toLowerCase();
  if (t === '') return defaultYes;
  return t === 'y' || t === 'yes';
}

function preflight() {
  const nodeMajor = Number(process.versions.node.split('.')[0]);
  if (nodeMajor < 18) {
    console.error(`Node 18+ required (current: ${process.versions.node})`);
    process.exit(1);
  }
  const hook = hookPathForPlugin(PLUGIN_ROOT);
  if (!fs.existsSync(hook)) {
    console.error(`fetch-hook.cjs missing at ${hook}`);
    process.exit(1);
  }
}

/** Pick up an HTTPS_PROXY to bake into the alias. Priority:
 *    1. current shell env (user ran `export HTTPS_PROXY=...`)
 *    2. an existing `alias claude='HTTPS_PROXY=URL claude'` line already in rc
 *       (typical for users who set proxy via alias for a single command)
 *  Returns null when nothing detected. */
function detectProxyForAlias(rcText) {
  if (process.env.HTTPS_PROXY) return process.env.HTTPS_PROXY;
  if (rcText) {
    const fromAlias = detectExistingProxy(rcText);
    if (fromAlias) return fromAlias;
  }
  return null;
}

async function cmdOn() {
  preflight();

  const shell = detectShellRc();
  const proposedRc = shell.path;
  if (!proposedRc) {
    console.error(`Detected unsupported shell: ${shell.shellName}.`);
    console.error('Manual step required: add `alias claude=\'NODE_OPTIONS=--require=<hook> claude\'` to your rc.');
    process.exit(1);
  }

  const rcText = fs.existsSync(proposedRc) ? fs.readFileSync(proposedRc, 'utf8') : '';
  const detectedProxy = detectProxyForAlias(rcText);

  console.log('\n[token-reporter audit] Enabling audit captures:');
  console.log(`  - appends a \`${shell.shellName}\` alias to ${proposedRc}:`);
  console.log('      alias claude=\'NODE_OPTIONS=--require=<hook> claude\'');
  console.log('    (when you type `claude`, shell expands the alias once, then re-resolves');
  console.log('     `claude` via PATH to the real binary — NODE_OPTIONS is set before Node starts)');
  if (detectedProxy) {
    console.log(`  - detected HTTPS_PROXY=${detectedProxy}, baking into the alias so proxy still works`);
  }
  console.log(`  - captures every Anthropic API request/response body (PLAINTEXT) to ${OUT_DIR}`);
  console.log('  - includes: system prompt, tools schema, your prompts, assistant output, thinking');
  console.log('  - never uploaded; visible to anyone who can read your disk');
  console.log('  - reversible via `token-reporter-audit off`');
  console.log('  - clear captures via `token-reporter-audit purge`');

  const ok = await confirm('\nProceed? [y/N] ');
  if (!ok) { console.log('Cancelled.'); process.exit(2); }

  let shellRcPath = null;
  // If rc already has our marker, always re-run patchShellRc — it may rewrite
  // the alias line if the content drifted (e.g. plugin path changed).
  // Otherwise ask the user for consent.
  if (rcText.includes(SHELL_RC_MARKER)) {
    shellRcPath = proposedRc;
  } else {
    const agree = await confirm(
      `\nAppend alias to ${proposedRc}? [Y/n] `,
      /*defaultYes=*/ true,
    );
    if (agree) shellRcPath = proposedRc;
  }

  ensureDataDir();
  fs.mkdirSync(OUT_DIR, { recursive: true, mode: 0o700 });
  try { fs.chmodSync(OUT_DIR, 0o700); } catch {}

  let result;
  try {
    result = enableAudit({
      settingsPath: SETTINGS_PATH,
      configPath: CONFIG_PATH,
      pluginRoot: PLUGIN_ROOT,
      outDir: OUT_DIR,
      shellRcPath,
      httpsProxy: detectedProxy,
    });
  } catch (e) {
    console.error(e.message);
    process.exit(1);
  }

  if (result.settingsBackupPath) {
    console.log(`Backed up previous settings to ${result.settingsBackupPath}`);
  }
  console.log(`Alias line: ${result.aliasLine}`);
  if (result.shellRcPatched) {
    console.log(result.shellRcRewrote
      ? `Alias updated in: ${result.shellRcPatched}`
      : `Alias appended to: ${result.shellRcPatched}`);
    console.log('  → Open a new terminal (or `source` your rc) for it to take effect.');
  } else if (result.shellRcAlreadyPatched) {
    console.log('Shell rc already contains an up-to-date alias — no change.');
  } else if (proposedRc) {
    console.log(`\nManual step: append this to ${proposedRc}:`);
    console.log(`  ${result.aliasLine}`);
  }

  console.log('\nAudit enabled. Start a new `claude` session from a fresh shell to activate the hook.');
}

function cmdOff() {
  ensureDataDir();
  try {
    disableAudit({ settingsPath: SETTINGS_PATH, configPath: CONFIG_PATH });
  } catch (e) {
    console.error(e.message);
    process.exit(1);
  }
  console.log('Audit disabled. Alias removed from rc (if we added it); legacy shim cleaned up.');
  console.log('Start a new `claude` session from a fresh shell to take effect.');
}

function cmdStatus() {
  const cfg = loadAuditConfig(CONFIG_PATH);
  console.log(`auditEnabled: ${cfg.auditEnabled === true}`);
  console.log(`auditPromptedAt: ${cfg.auditPromptedAt || 'never'}`);
  console.log(`hook path: ${hookPathForPlugin(PLUGIN_ROOT)}`);
  console.log(`shell rc patched by us: ${cfg.shellRcPatched || 'no'}`);
  console.log(`captures dir: ${OUT_DIR}`);
  const hb = readHookHeartbeat(OUT_DIR);
  console.log(`last hook heartbeat: ${hb ? hb.at : 'none'}`);
  console.log(`hook stale: ${cfg.auditEnabled === true ? isHookStale(OUT_DIR) : 'n/a'}`);
  const snap = readManagedSnapshot(SETTINGS_PATH);
  for (const k of MANAGED_ENV_KEYS) {
    const r = snap[k];
    console.log(`  ${k}: ${r.present ? r.value : 'absent'}`);
  }
}

async function cmdPurge() {
  console.log(`This will delete all files under ${OUT_DIR}.`);
  const ok = await confirm('Continue? [y/N] ');
  if (!ok) { console.log('Cancelled.'); process.exit(2); }
  if (fs.existsSync(OUT_DIR)) {
    for (const name of fs.readdirSync(OUT_DIR)) {
      try { fs.rmSync(path.join(OUT_DIR, name), { recursive: true, force: true }); } catch {}
    }
  }
  console.log('Captures purged.');
}

const positionals = process.argv.slice(2).filter((a) => !a.startsWith('-'));
const cmd = positionals[0];
try {
  if (cmd === 'on') await cmdOn();
  else if (cmd === 'off') cmdOff();
  else if (cmd === 'status') cmdStatus();
  else if (cmd === 'purge') await cmdPurge();
  else {
    console.error('Usage: token-reporter-audit {on|off|status|purge} [-y|--yes]');
    console.error('  -y, --yes    Auto-answer "yes" to all prompts (scripting).');
    process.exit(64);
  }
} finally {
  rlClose();
}
