#!/usr/bin/env node
// 接管 Claude Code statusline：备份原配置 → 安装 glm 包装（智谱显示用量 / 非智谱透传）
import os from 'node:os';
import path from 'node:path';
import {createInstaller} from '../scripts/install-statusline.mjs';

const installer = createInstaller({claudeDir: path.join(os.homedir(), '.claude')});
const result = installer.on();
console.log(`${result.success ? '✓' : '✗'} ${result.message}`);
if (result.originalStatusLine !== undefined) {
  console.log(`  原配置已备份: ${result.backupPath}`);
  console.log(`  原配置内容: ${JSON.stringify(result.originalStatusLine)}`);
}
process.exit(result.success ? 0 : 1);
