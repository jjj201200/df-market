#!/usr/bin/env node
// 查看 glm statusline 接管状态
import os from 'node:os';
import path from 'node:path';
import {createInstaller} from '../scripts/install-statusline.mjs';

const installer = createInstaller({claudeDir: path.join(os.homedir(), '.claude')});
const s = installer.status();
console.log(`接管状态: ${s.integrated ? '已接管' : '未接管'}`);
console.log(`当前 statusLine: ${s.currentCommand ?? '（未配置）'}`);
console.log(`备份存在: ${s.hasBackupFile ? '是' : '否'}`);
if (s.hasBackupFile) console.log(`备份内容: ${JSON.stringify(s.backup)}`);
